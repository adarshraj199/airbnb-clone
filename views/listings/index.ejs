<% layout("/layouts/boilerplate") %>
<style>
.filters{
  margin-top: 2rem;
  display: flex;
  align-items: center;
  justify-content: space-around;
  /* border: 2px solid pink;
  border-radius: 2rem; */

 
}

.icons{
  margin-top: 0.6rem;
  margin-right: 2.5rem;
  text-align: center;
}
.icons:hover{
  opacity: 0.7;
  cursor: pointer;
  scale: 1.2;
}

.icons p{
 font-size: 0.8rem;
}

.tax{
  display: none;
}

.tax-toggle{
  border: 1px solid black;
  padding: 0.5rem 1rem 0.5rem 1rem ;
  border-radius: 1rem;
  height: 3rem;

  
 


}

.tax-toggle  label{
  margin-left: 1rem;
  

  

}

</style>


 


<div class="filters">

  <div class="icons">
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
  </div>

  <div class="icons">
   <i class="fa-solid fa-bed"></i>
    <p>Rooms</p>
  </div>
  <div class="icons">
 <i class="fa-solid fa-mountain-city"></i>
    <p>Iconic Cities</p>
  </div>
  <div class="icons">
  <i class="fa-solid fa-mountain"></i>
    <p>Mountains</p>
  </div>
  <div class="icons">
    <i class="fa-brands fa-fort-awesome"></i>
    <p>Castels</p>
  </div>
  <div class="icons">
  <i class="fa-solid fa-person-swimming"></i>
    <p>Pools</p>
  </div>
  <div class="icons">
    <i class="fa-solid fa-campground"></i>
    <p>Campings</p>
  </div>
  <div class="icons">
   <i class="fa-solid fa-cow"></i>
    <p>Farms</p>
  </div>
  <div class="icons">
  <i class="fa-solid fa-igloo"></i>
    <p>Artic</p>
  </div>
  <div class="icons">
  <i class="fa-solid fa-sailboat"></i>
    <p>Boats</p>
  </div>


  <div class="form-check-reverse form-switch tax-toggle">
  <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">Display total after Taxes</label>
</div>

</div>


 <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-4">
      <% for(let listing of allListings) {%>
<a href="/listings/<%=listing._id %>" class="listing-link">
  <div class="card" >
  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;" >
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text">
     <b> <%=listing.title %> <br></b>
  &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>/night
   <i class="tax">&nbsp; &nbsp;+ 18% GST</i>
    </p>
  </div>
</div>
</a>

 <% } %>

 </div>


<script>
  let taxswitch = document.getElementById("flexSwitchCheckDefault");
  taxswitch.addEventListener("click" , ()=> {
    let tax = document.getElementsByClassName("tax");
    for(info of tax){
      if(info.style.display !="inline"){
        info.style.display= "inline";
      }else{
         info.style.display= "none";
      }
    }
   
  })
</script>