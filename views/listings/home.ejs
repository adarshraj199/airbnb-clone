<% layout("/layouts/boilerplate") %>



<div class="hero-section">
    <video autoplay muted loop playsinline class="hero-video">
        <source src="/i_do_not_want_like_it_in_webs.mp4" type="video/mp4">
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1 class="hero-title">Airbnb-Clone</h1>
        <p class="hero-subtitle">Find your next stay, anywhere in the world</p>
        <a href="/listings" class="btn btn-light btn-lg hero-btn">Explore Listings</a>
    </div>
</div>

<div class="stats-section text-center py-5">
    <div class="row slide-left stats-box">
        <div class="col-md-4 mt-2">
            <h2>10,000+</h2>
            <p>Listings</p>
        </div>
        <div class="col-md-4 mt-2">
            <h2>500+</h2>
            <p>Cities</p>
        </div>
        <div class="col-md-4 mt-2">
            <h2>1M+</h2>
            <p>Happy Guests</p>
        </div>
    </div>
</div>

<div class="features-section text-center py-5">
    <h2 class="mb-3">Why book with us?</h2>
    <p class="text-muted mb-5">Handpicked stays, verified hosts, easy booking</p>
    <div class="row g-4 slide-right">
        <div class="col-md-4">
            <h5>Verified Listings</h5>
            <p>Every property is checked before it goes live.</p>
        </div>
        <div class="col-md-4">
            <h5>Secure Booking</h5>
            <p>Your payments and data are always protected.</p>
        </div>
        <div class="col-md-4">
            <h5>24/7 Support</h5>
            <p>We're here whenever you need help.</p>
        </div>
    </div>
</div>

<script src="/js/animation.js"></script>


